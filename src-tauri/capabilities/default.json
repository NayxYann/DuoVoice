{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for DuoVoice desktop windows",
  "windows": [
    "main",
    "tray",
    "tray-menu"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "updater:default",
    "process:default",
    "core:window:allow-hide",
    "core:window:allow-set-size"
  ]
}
