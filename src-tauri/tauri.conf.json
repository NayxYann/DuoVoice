{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoVoice",
  "version": "1.2.0",
  "identifier": "fr.duovoice.intercom",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DuoVoice",
        "width": 1080,
        "height": 760,
        "resizable": true,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false
      },
      {
        "label": "tray",
        "title": "DuoVoice",
        "url": "tray.html",
        "width": 238,
        "height": 292,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "focus": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0OUYwQUNBODVDMDZERjUKUldUMWJjQ0Z5Z3FmeEhESFZnREdMQ0hRSzJZVFFVQnlHOTU2c29lZlVRbTZJN0V4OGRKUEVLWUsK",
      "endpoints": [
        "https://github.com/NayxYann/DuoVoice/releases/latest/download/latest.json"
      ]
    },
    "autostart": null,
    "process": {}
  }
}
