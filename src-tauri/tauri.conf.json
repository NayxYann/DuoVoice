{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoVoice",
  "version": "1.1.0",
  "identifier": "fr.duovoice.intercom",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "DuoVoice",
        "width": 1080,
        "height": 800,
        "resizable": true,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "autostart": null,
    "process": {}
  }
}
